rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidRating(data) {
      return data.keys().hasAll(['rating', 'feedback', 'createdAt']) &&
        data.keys().hasOnly(['rating', 'feedback', 'createdAt', 'category', 'appVersion', 'language']) &&
        data.rating is number && data.rating >= 1 && data.rating <= 5 &&
        data.feedback is string && data.feedback.size() <= 1000 &&
        data.createdAt is string && data.createdAt.size() <= 40 &&
        (!('category' in data) || (data.category is string && data.category.size() <= 50)) &&
        (!('appVersion' in data) || (data.appVersion is string && data.appVersion.size() <= 20)) &&
        (!('language' in data) || (data.language is string && data.language.size() <= 10));
    }

    // Ratings collection:
    // Anyone can create a rating submission with strictly validated schema.
    // Ratings are write-only by clients; cannot be publicly queried or modified to prevent tampering or scraping.
    match /ratings/{ratingId} {
      allow create: if isValidId(ratingId) && isValidRating(incoming());
      allow read, update, delete: if false;
    }
  }
}
